<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title$ · Personal CRM DB</title>
<style>
  :root { color-scheme: light dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5em 1.25em 4em;
    line-height: 1.5;
    color: #24292f;
    background: #fff;
  }
  @media (prefers-color-scheme: dark) {
    body { color: #e6edf3; background: #0d1117; }
    th { background: #161b22 !important; }
    code, pre { background: #161b22 !important; }
    th, td { border-color: #30363d !important; }
    a { color: #58a6ff !important; }
    nav { border-bottom-color: #30363d !important; }
    h1, h2, h3 { border-bottom-color: #30363d !important; }
  }
  nav { padding: 0.25em 0 0.75em; border-bottom: 1px solid #eaecef; margin-bottom: 1em; font-size: 0.9em; }
  h1, h2, h3 { border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; }
  h1 { margin-top: 0; }
  table { border-collapse: collapse; width: 100%; font-size: 0.88em; margin: 0.5em 0 1.5em; }
  th, td { border: 1px solid #d0d7de; padding: 6px 10px; text-align: left; vertical-align: top; }
  th { background: #f6f8fa; font-weight: 600; }
  td { overflow-wrap: anywhere; }
  code { background: #f6f8fa; padding: 1px 5px; border-radius: 3px; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 0.85em; }
  pre { background: #f6f8fa; padding: 12px; border-radius: 6px; overflow-x: auto; }
  pre code { background: transparent; padding: 0; font-size: 0.85em; }
  a { color: #0969da; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .mermaid { text-align: center; margin: 1em 0; }
  .mermaid svg { max-width: 100%; height: auto; }
  hr { border: none; border-top: 1px solid #eaecef; margin: 2em 0 1em; }
</style>
</head>
<body>
<nav><a href="README.html">← All tables</a></nav>
$body$
<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
<script>
// Pandoc renders ```mermaid fences as <pre class="mermaid"><code>…</code></pre>.
// Convert to <div class="mermaid"> with decoded text so Mermaid.js can render.
document.querySelectorAll('pre.mermaid').forEach(function (pre) {
  var div = document.createElement('div');
  div.className = 'mermaid';
  div.textContent = pre.textContent;
  pre.replaceWith(div);
});
mermaid.initialize({ startOnLoad: true, theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'default' });
</script>
</body>
</html>
