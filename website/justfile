set shell := ["bash", "-uc"]

default:
    @just --list

# Serve the marketing site locally on the tailnet (no build step needed).
# URL is printed at startup (resolved from local tailscale daemon).
[group('Dev')]
dev port="8080":
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v tailscale &>/dev/null; then
        echo "tailscale not found — serving on localhost instead"
        python3 -m http.server {{port}} --directory "{{justfile_directory()}}"
        exit 0
    fi
    IP=$(tailscale ip -4)
    HOST=$(tailscale status --json | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['Self']['DNSName'].rstrip('.'))")
    echo "Serving at http://${HOST}:{{port}}"
    python3 -m http.server {{port}} --bind "$IP" --directory "{{justfile_directory()}}"

# Open index.html directly in the default browser (no server needed).
[group('Dev')]
render:
    open "{{justfile_directory()}}/index.html"

# Validate the HTML with tidy (warnings only, non-blocking).
[group('Dev')]
lint:
    tidy -q -e "{{justfile_directory()}}/index.html" || true

# Deploy to Cloudflare Pages (withkindred.app).
# Credentials auto-decrypted from deploy.env.sops.
[group('Deploy')]
deploy:
    #!/usr/bin/env bash
    set -euo pipefail
    SOPS_CONFIG="{{justfile_directory()}}/../.sops.yaml"
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        export "$key=$value"
    done < <(sops --config "$SOPS_CONFIG" --input-type=dotenv --output-type=dotenv -d "{{justfile_directory()}}/deploy.env.sops")
    CF_COMMIT_SHA=$(git rev-parse HEAD)
    CF_COMMIT_MSG=$(git log -1 --pretty=%s)
    CF_BRANCH=$(git branch --show-current)
    bunx wrangler@latest pages deploy "{{justfile_directory()}}" \
        --project-name=kindred-web \
        --branch="$CF_BRANCH" \
        --commit-hash="$CF_COMMIT_SHA" \
        --commit-message="$CF_COMMIT_MSG"
