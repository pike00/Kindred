    message_id [type: btree, name: "ix_interaction_message_id"]
    occurred_at [type: btree, name: "ix_interaction_occurred_at"]
    owner_id [type: btree, name: "ix_interaction_owner_id"]
    search_vector [type: gin, name: "ix_interaction_search_vector"]
  }
}

