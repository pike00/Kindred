  "entity_type" varchar(64) [not null]
  "entity_id" uuid [not null]
  "action" varchar(32) [not null]
  "changes_json" json
  "occurred_at" timestamptz [not null]
  "acting_api_key_id" uuid

  Indexes {
    acting_api_key_id [type: btree, name: "ix_activity_log_acting_api_key_id"]
    actor_id [type: btree, name: "ix_activity_log_actor_id"]
