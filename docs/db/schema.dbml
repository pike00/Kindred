    contact_id [type: btree, name: "ix_relationship_contact_id"]
    inverse_id [type: btree, name: "ix_relationship_inverse_id"]
    related_contact_id [type: btree, name: "ix_relationship_related_contact_id"]
  }
}

Table "pet" {
  "id" uuid [pk, not null]
  "contact_id" uuid [not null]
  "name" varchar(255) [not null]
  "species" varchar(100)
  "breed" varchar(100)
  "notes" varchar(1000)

  Indexes {
    contact_id [type: btree, name: "ix_pet_contact_id"]
  }
}

Table "custom_field_definition" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
  "name" varchar(255) [not null]
  "field_type" varchar(50) [not null]
  "description" varchar(500)
  "options" varchar(2000)
  "icon" varchar(50)
  "created_at" timestamptz [not null]

  Indexes {
    owner_id [type: btree, name: "ix_custom_field_definition_owner_id"]
  }
}

Table "custom_field_value" {
  "id" uuid [pk, not null]
  "contact_id" uuid [not null]
  "field_definition_id" uuid [not null]
  "value" varchar(5000) [not null]

  Indexes {
    contact_id [type: btree, name: "ix_custom_field_value_contact_id"]
    field_definition_id [type: btree, name: "ix_custom_field_value_field_definition_id"]
  }
}

Table "interaction" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
  "channel" interactionchannel [not null]
  "occurred_at" timestamptz [not null]
  "notes" varchar(10000)
  "mood" varchar(50)
  "duration_minutes" int4
  "created_at" timestamptz [not null]

  Indexes {
    channel [type: btree, name: "ix_interaction_channel"]
    occurred_at [type: btree, name: "ix_interaction_occurred_at"]
    owner_id [type: btree, name: "ix_interaction_owner_id"]
  }
}

Table "reminder" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
  "contact_id" uuid
  "title" varchar(500) [not null]
  "description" varchar(2000)
  "remind_at" timestamptz [not null]
  "frequency" reminderfrequency [not null]
  "is_active" bool [not null]
  "last_sent_at" timestamptz
  "snoozed_until" timestamptz
  "created_at" timestamptz [not null]

  Indexes {
    contact_id [type: btree, name: "ix_reminder_contact_id"]
    is_active [type: btree, name: "ix_reminder_is_active"]
    owner_id [type: btree, name: "ix_reminder_owner_id"]
    remind_at [type: btree, name: "ix_reminder_remind_at"]
  }
}

Table "gift" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
  "contact_id" uuid [not null]
  "name" varchar(500) [not null]
  "description" varchar(2000)
  "status" giftstatus [not null]
  "occasion" varchar(255)
  "date" date
  "value_amount" float8
  "value_currency" varchar(3) [not null]
  "url" varchar(2048)
  "created_at" timestamptz [not null]

  Indexes {
    contact_id [type: btree, name: "ix_gift_contact_id"]
    owner_id [type: btree, name: "ix_gift_owner_id"]
    status [type: btree, name: "ix_gift_status"]
  }
}

Table "debt" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
