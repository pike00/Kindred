    contact_id [type: btree, name: "ix_relationship_contact_id"]
    inverse_id [type: btree, name: "ix_relationship_inverse_id"]
    related_contact_id [type: btree, name: "ix_relationship_related_contact_id"]
  }
}

Table "pet" {
