  }
}

Table "custom_field_value" {
  "id" uuid [pk, not null]
  "contact_id" uuid [not null]
  "field_definition_id" uuid [not null]
  "value" varchar(5000) [not null]

  Indexes {
    contact_id [type: btree, name: "ix_custom_field_value_contact_id"]
