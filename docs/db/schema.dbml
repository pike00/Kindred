Enum "contactfieldtype" {
  "EMAIL"
  "PHONE"
}

Enum "contactsource" {
  "MANUAL"
  "VCARD_IMPORT"
  "CARDDAV"
  "GOOGLE"
  "WEBHOOK"
}

Enum "debtdirection" {
  "I_OWE"
  "THEY_OWE"
}

Enum "giftstatus" {
  "IDEA"
  "GIVEN"
  "RECEIVED"
  "PURCHASED"
  "WRAPPED"
}

Enum "interactionchannel" {
  "CALL"
  "IN_PERSON"
  "TEXT"
  "EMAIL"
  "VIDEO"
  "SOCIAL"
  "OTHER"
}

Enum "mediacategory" {
  "MOVIE"
  "TV_SHOW"
  "PODCAST"
  "MUSICIAN"
  "BOOK"
  "OTHER"
}

Enum "oauthprovider" {
  "GOOGLE"
}

Enum "reminderfrequency" {
  "ONCE"
  "DAILY"
  "WEEKLY"
  "MONTHLY"
  "YEARLY"
}

Table "alembic_version" {
  "version_num" varchar(32) [pk, not null]
}

Table "user" {
  "email" varchar(255) [unique, not null]
  "is_active" bool [not null]
  "is_superuser" bool [not null]
  "full_name" varchar(255)
  "hashed_password" varchar
  "id" uuid [pk, not null]
  "created_at" timestamptz
  "oidc_iss" varchar(512)
  "oidc_sub" varchar(255)

  Indexes {
    (oidc_iss, oidc_sub) [type: btree, unique, name: "uq_user_oidc_identity"]
    oidc_iss [type: btree, name: "ix_user_oidc_iss"]
    oidc_sub [type: btree, name: "ix_user_oidc_sub"]
  }
}

Table "tag" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
  "name" varchar(100) [not null]
  "color" varchar(7)
  "created_at" timestamptz [not null]

  Indexes {
    owner_id [type: btree, name: "ix_tag_owner_id"]
  }
}

Table "group" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
  "name" varchar(255) [not null]
  "description" varchar(1000)
  "created_at" timestamptz [not null]

  Indexes {
    owner_id [type: btree, name: "ix_group_owner_id"]
  }
}

Table "contact" {
  "id" uuid [pk, not null]
  "owner_id" uuid [not null]
  "first_name" varchar(255) [not null]
  "last_name" varchar(255)
  "middle_name" varchar(255)
  "prefix" varchar(50)
  "suffix" varchar(50)
  "nickname" varchar(255)
  "company" varchar(255)
  "department" varchar(255)
  "title" varchar(255)
  "birthday" date
  "how_we_met" varchar(2000)
  "is_favorite" bool [not null]
  "is_archived" bool [not null]
  "is_deceased" bool [not null]
  "deceased_at" date
  "contact_frequency_days" int4
  "stage" varchar(100)
  "vcard_raw" varchar
  "vcard_etag" varchar(255)
  "avatar_url" varchar(2048)
  "last_contacted_at" timestamptz
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "deleted_at" timestamptz
  "source" contactsource [not null, default: 'MANUAL']
  "source_external_id" varchar(500)
  "organization_id" uuid

  Indexes {
    (owner_id, source, source_external_id) [type: btree, unique, name: "uq_contact_owner_source_external_id"]
    contact_frequency_days [type: btree, name: "ix_contact_contact_frequency_days"]
    deleted_at [type: btree, name: "ix_contact_deleted_at"]
    is_archived [type: btree, name: "ix_contact_is_archived"]
    is_favorite [type: btree, name: "ix_contact_is_favorite"]
    owner_id [type: btree, name: "ix_contact_owner_id"]
  }
}

Table "contact_tag" {
  "contact_id" uuid [not null]
  "tag_id" uuid [not null]

  Indexes {
    (contact_id, tag_id) [pk, type: btree, name: "contact_tag_pkey"]
  }
}

Table "contact_group" {
  "contact_id" uuid [not null]
  "group_id" uuid [not null]

  Indexes {
    (contact_id, group_id) [pk, type: btree, name: "contact_group_pkey"]
  }
}

Table "contact_field" {
  "id" uuid [pk, not null]
  "contact_id" uuid [not null]
  "field_type" contactfieldtype [not null]
  "label" varchar(100) [not null]
  "value" varchar(2048) [not null]
  "is_primary" bool [not null]
  "sort_order" int4 [not null]

  Indexes {
    contact_id [type: btree, name: "ix_contact_field_contact_id"]
    field_type [type: btree, name: "ix_contact_field_field_type"]
  }
}

Table "address" {
  "id" uuid [pk, not null]
  "contact_id" uuid [not null]
  "label" varchar(100) [not null]
  "street" varchar(500)
  "extended" varchar(500)
  "city" varchar(255)
  "region" varchar(255)
  "postal_code" varchar(50)
  "country" varchar(255)
  "latitude" float8
  "longitude" float8

  Indexes {
    contact_id [type: btree, name: "ix_address_contact_id"]
  }
}

Table "relationship" {
  "id" uuid [pk, not null]
