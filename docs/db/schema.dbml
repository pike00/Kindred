  "currency" varchar(3) [not null]
  "reason" varchar(1000)
  "is_settled" bool [not null]
  "settled_at" date
  "created_at" timestamptz [not null]

  Indexes {
    contact_id [type: btree, name: "ix_debt_contact_id"]
