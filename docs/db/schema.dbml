  "encrypted_refresh_token" varchar [not null]
  "encrypted_access_token" varchar
  "access_token_expires_at" timestamptz
  "scopes" varchar(2000) [not null, default: '']
  "sync_token" varchar(4000)
  "last_synced_at" timestamptz
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]

  Indexes {
    (user_id, provider) [type: btree, unique, name: "uq_oauth_credential_user_provider"]
    provider [type: btree, name: "ix_oauth_credential_provider"]
    user_id [type: btree, name: "ix_oauth_credential_user_id"]
  }
}

Table "note_mention" {
  "note_id" uuid [not null]
  "contact_id" uuid [not null]

  Indexes {
    (note_id, contact_id) [pk, type: btree, name: "note_mention_pkey"]
    contact_id [type: btree, name: "ix_note_mention_contact_id"]
  }
}

Table "communication_preference" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "contact_id" uuid [unique, not null]
  "preferred_channel" varchar(20)
  "best_time_local" varchar(11)
  "do_not_contact" bool [not null, default: false]
  "do_not_contact_reason" varchar(500)
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "api_key" {
  "id" uuid [pk, not null]
  "name" varchar(255) [not null]
  "key_hash" varchar(64) [unique, not null]
  "key_prefix" varchar(16) [not null]
  "owned_by_user_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "last_used_at" timestamptz
  "revoked_at" timestamptz
  "expires_at" timestamptz

  Indexes {
    key_hash [type: btree, name: "ix_api_key_key_hash"]
    owned_by_user_id [type: btree, name: "ix_api_key_owned_by_user_id"]
  }
}

Table "api_key_impersonate" {
  "api_key_id" uuid [not null]
  "user_id" uuid [not null]

  Indexes {
    (api_key_id, user_id) [pk, type: btree, name: "api_key_impersonate_pkey"]
  }
}

Table "organization" {
  "name" varchar(255) [not null]
  "domain" varchar(255)
  "industry" varchar(255)
