meta {
  name: Create Contact
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/contacts/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "first_name": "Alice",
    "last_name": "Smith",
    "nickname": "Ali",
    "company": "Acme Corp",
    "title": "Engineer",
    "birthday": "1990-06-15",
    "how_we_met": "At a conference"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("contact_id", res.body.id);
  }
}
