meta {
  name: Log Interaction
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/interactions/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "channel": "in_person",
    "occurred_at": "2026-05-03T12:00:00Z",
    "notes": "Grabbed lunch. Caught up on work and family.",
    "mood": "great",
    "duration_minutes": 90,
    "attendee_ids": ["{{contact_id}}"]
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("interaction_id", res.body.id);
  }
}
