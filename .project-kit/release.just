# .project-kit/release.just — generated for kindred
# Generated by project-kit (skill version: 0.3.0)
# Last refreshed: 2026-10-08

release-prepare LEVEL="patch":
    @just context
    @uv run .project-kit/scripts/release.py prepare {{LEVEL}}

release-prepare-dry LEVEL="patch":
    @just context
    @uv run .project-kit/scripts/release.py prepare {{LEVEL}} --dry-run

release-publish TAG:
    @just context
    @uv run .project-kit/scripts/release.py publish {{TAG}}

release-publish-dry TAG:
    @just context
    @uv run .project-kit/scripts/release.py publish {{TAG}} --dry-run

release-check LEVEL="patch":
    @just context
    @uv run .project-kit/scripts/release.py check {{LEVEL}}

changelog:
    @just context
    @uvx git-cliff@2.14.2 --config .project-kit/cliff.toml --output CHANGELOG.md

notes TAG:
    @just context
    @uv run .project-kit/scripts/release.py notes --tag {{TAG}}

# Print local latest tag + deployed prod version (resolved per prod_source).
version:
    @just context
    @uv run .project-kit/scripts/release.py version
