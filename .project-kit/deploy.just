# .project-kit/deploy.just — generated for kindred (target=homelab)
# Generated by project-kit (skill version: 0.1.0)
# Last refreshed: 2026-06-27

deploy ENV="prod":
    @uv run .project-kit/scripts/deploy-homelab.py --env {{ENV}}

deploy-dry ENV="prod":
    @uv run .project-kit/scripts/deploy-homelab.py --env {{ENV}} --dry-run

rollback ENV="prod":
    @uv run .project-kit/scripts/deploy-homelab.py --env {{ENV}} --rollback

status ENV="prod":
    @uv run .project-kit/scripts/deploy-homelab.py --env {{ENV}} --status

# Compound: release + build + deploy in one shot. Lives with deploy (not release)
# so a repo that adopts only the release subsystem keeps its own `ship`.
ship LEVEL="patch":
    @just release {{LEVEL}}
    @just build "$(git describe --tags --abbrev=0 2>/dev/null || true)"
    @just deploy
