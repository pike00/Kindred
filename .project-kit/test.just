# .project-kit/test.just — generated for kindred (python+ts)
# Generated by project-kit (skill version: 0.3.0)
# Last refreshed: 2026-11-02

# Run all configured test layers in order
test: _context-check test-all

test-all: _context-check
    @just lint
    @just typecheck
    @just test-backend
    @just test-frontend
    @just test-e2e

test-fast: _context-check
    @just lint
    @just typecheck

test-unit: _context-check
    @just test-backend
    @just test-frontend

test-backend: _context-check
    @docker compose -f compose.dev.yml exec -T backend pytest

test-frontend: _context-check
    @cd frontend && pnpm run test

test-e2e: _context-check
    @bash scripts/run-e2e-prepush.sh

smoke TARGET="preview" TAG="": _context-check
    @just _skip "smoke tests"

test-watch: _context-check
    @just _skip "backend watch"

lint: _context-check
    @cd frontend && pnpm exec biome check src && cd ../backend && uvx ruff check app

typecheck: _context-check
    @cd frontend && pnpm exec tsc --noEmit
