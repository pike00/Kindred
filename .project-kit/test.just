# .project-kit/test.just — generated for kindred (python+ts)
# Generated by project-kit (skill version: 0.2.0)
# Last refreshed: 2026-09-21

# Run all configured test layers in order
test: test-all

test-all:
    @just lint
    @just typecheck
    @just test-backend
    @just test-frontend
    @just test-e2e

test-fast:
    @just lint
    @just typecheck

test-unit:
    @just test-backend
    @just test-frontend

test-backend:
    @docker compose -f compose.dev.yml exec -T backend pytest

test-frontend:
    @cd frontend && pnpm run test

test-e2e:
    @bash scripts/run-e2e-prepush.sh

smoke TARGET="preview" TAG="":
    @just _skip "smoke tests"

test-watch:
    @just _skip "backend watch"

lint:
    @cd frontend && pnpm exec biome check src && cd ../backend && uvx ruff check app

typecheck:
    @cd frontend && pnpm exec tsc --noEmit
