# .project-kit/clean.just — generated for kindred (python+ts)
# Generated by project-kit (skill version: 0.1.0)
# Last refreshed: 2026-06-27

clean:
    @rm -rf dist/ build/ .pytest_cache/ .ruff_cache/ .mypy_cache/
    @find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    @rm -rf frontend/dist/ frontend/.next/ frontend/.svelte-kit/ 2>/dev/null || true
    @echo "[clean] artifacts removed"

clean-all:
    @just clean
    @rm -rf .venv/ .uv-cache/
    @rm -rf node_modules/ frontend/node_modules/ 2>/dev/null || true
    @echo "[clean-all] deep clean complete"

clean-docker:
    @docker images "ghcr.io/pike00/kindred" -q | xargs -r docker rmi -f
    @echo "[clean-docker] removed images: kindred"
