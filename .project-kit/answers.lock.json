{
  "branch": "main",
  "build": {
    "cargo_enabled": false,
    "enabled": true,
    "image_enabled": true,
    "image_name": null,
    "image_registry": "ghcr.io/pike00",
    "images": [
      {
        "build_args": {
          "VITE_API_URL": "${VITE_API_URL:-}"
        },
        "context": ".",
        "dockerfile": "Dockerfile.prod",
        "name": "kindred",
        "registry": "ghcr.io/pike00"
      }
    ],
    "wheel_enabled": false
  },
  "ci": {
    "enabled": false,
    "engine": "none",
    "gate": [
      "test-all"
    ],
    "on_pr": true,
    "on_push": true,
    "required_check": null
  },
  "clean": {
    "enabled": true
  },
  "db": {
    "backend": "none",
    "enabled": false
  },
  "delete_recipes": [
    "build",
    "deploy",
    "ship",
    "typecheck",
    "test-all",
    "frontend-test"
  ],
  "deploy": {
    "allow_legacy_apply": false,
    "cf_worker": null,
    "custom_command": null,
    "enabled": true,
    "homelab_app": "kindred",
    "homelab_mode": "bump",
    "host": null,
    "pypi_package": null,
    "remote_compose_root": "~/.local/share/project-kit-apps",
    "ssh_alias": null,
    "sync_checkout": false,
    "target": "homelab"
  },
  "docs": {
    "backend": "none",
    "deploy_custom_command": null,
    "deploy_project_name": null,
    "deploy_target": "none",
    "enabled": false,
    "output_dir": "site",
    "source_dir": "docs"
  },
  "domain": "",
  "execution": {
    "targets": {}
  },
  "language": "python+ts",
  "managed_subsystems": [],
  "preview": {
    "base": "main",
    "compose_file": "compose.worktree.yml",
    "enabled": true,
    "health_path": "/api/v1/utils/health-check/",
    "host_pattern": "{slug}.dev.kindred.{domain}",
    "ports": {},
    "project_prefix": "kindred",
    "shell_service": "backend",
    "test_command": "pytest",
    "test_service": null
  },
  "project_name": "kindred",
  "public": true,
  "refreshed_at": "2026-09-21",
  "release": {
    "dedicated_llm_key": false,
    "enabled": true,
    "install_command": null,
    "litellm_base_url": "",
    "litellm_model": "deepseek-v4-pro-cloud",
    "prod_homelab_env": "",
    "prod_pypi_package": "",
    "prod_source": "none"
  },
  "setup": {
    "backend": "uv sync --project backend",
    "enabled": true,
    "frontend": "corepack enable && pnpm install",
    "hooks": false,
    "precommit": false
  },
  "skill_version": "0.2.0",
  "test": {
    "backend": {
      "cmd": "docker compose -f compose.dev.yml exec -T backend pytest",
      "watch": null
    },
    "e2e": {
      "cmd": "bash scripts/run-e2e-prepush.sh",
      "watch": null
    },
    "enabled": true,
    "frontend": {
      "cmd": "cd frontend && pnpm run test",
      "watch": null
    },
    "lint": {
      "cmd": "cd frontend && pnpm exec biome check src && cd ../backend && uvx ruff check app",
      "watch": null
    },
    "smoke": {
      "command": null,
      "enabled": false,
      "endpoint": "/healthz",
      "expected_status": 200,
      "target": "preview",
      "timeout_seconds": 30
    },
    "typecheck": {
      "cmd": "cd frontend && pnpm exec tsc --noEmit",
      "watch": null
    }
  }
}
