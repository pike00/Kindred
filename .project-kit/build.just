# .project-kit/build.just — generated for kindred
# Generated by project-kit (skill version: 0.2.0)
# Last refreshed: 2026-09-21

# Build every artifact from an existing SemVer release tag.
build tag="":
    @just build-image "{{tag}}"
    @just build-wheel
    @just build-cargo

# Build 1 image(s) with buildx and push to the registry.
# Every image is tagged with the existing SemVer release tag. :latest is moved
# only for a validated release tag. Build hashes are metadata, never image tags.
build-image tag="":
    @uv run .project-kit/scripts/build-image.py "{{tag}}"

build-wheel:
    @just _skip "wheel build"

build-cargo:
    @just _skip "cargo build"

publish tag="":
    @just build-image "{{tag}}"
