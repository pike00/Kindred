# .project-kit/preview.just — generated for kindred
# Generated by project-kit (skill version: 0.1.0)
# Last refreshed: 2026-05-31

dev:
    @docker compose -f compose.dev.yml up -d

down:
    @docker compose -f compose.dev.yml down

down-clean:
    @docker compose -f compose.dev.yml down -v

logs SERVICE="":
    @docker compose -f compose.dev.yml logs -f {{SERVICE}}

ps:
    @docker compose -f compose.dev.yml ps

shell SERVICE="backend":
    @docker compose -f compose.dev.yml exec {{SERVICE}} sh

worktree SLUG:
    @git worktree add .worktrees/{{SLUG}} -b feat/{{SLUG}}

worktree-rm SLUG:
    @git worktree remove .worktrees/{{SLUG}}
    @git branch -D feat/{{SLUG}} 2>/dev/null || true

pr:
    @uv run .project-kit/scripts/preview-pr.py

env:
    @echo "project: kindred"
    @echo "language: python+ts"
    @echo "preview enabled: True"
